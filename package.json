{
  "name": "tingjian-audio-description-demo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-server.mjs",
    "build:worker": "node scripts/build.mjs",
    "check:contest": "node --env-file-if-exists=.env scripts/check-config.mjs",
    "dev": "node --env-file-if-exists=.env server/local.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 5294",
    "start": "node --env-file-if-exists=.env server/local.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
