{
  "duration": 200,
  "title": "雨停之前",
  "video": "assets/rain-before.mp4",
  "sha256": "3683a2d5eb7921f76fdfc7e65d97741eb9e032b87c3b70785dd6986b2895a9a5",
  "bytes": 8791640,
  "dialogues": [
    {
      "start": 18,
      "end": 20.174,
      "speaker": "林夏",
      "text": "师傅，打扰了。我能在这里躲一会儿雨吗？",
      "kind": "dialogue"
    },
    {
      "start": 26,
      "end": 28.054,
      "speaker": "陈伯",
      "text": "进来吧。伞放在门边，小心地滑。",
      "kind": "dialogue"
    },
    {
      "start": 44,
      "end": 45.681,
      "speaker": "林夏",
      "text": "您这里的钟，怎么走得不一样快？",
      "kind": "dialogue"
    },
    {
      "start": 54,
      "end": 56.83,
      "speaker": "陈伯",
      "text": "它们记着不同的时间。有的走得急，有的愿意等一等。",
      "kind": "dialogue"
    },
    {
      "start": 71,
      "end": 74.004,
      "speaker": "林夏",
      "text": "我叫林夏，正在赶车。可这雨一下，就什么都耽误了。",
      "kind": "dialogue"
    },
    {
      "start": 91,
      "end": 92.317,
      "speaker": "小宇",
      "text": "陈伯，我来拿爷爷的表！",
      "kind": "dialogue"
    },
    {
      "start": 98,
      "end": 99.957,
      "speaker": "陈伯",
      "text": "小宇，来看看。指针又走起来了。",
      "kind": "dialogue"
    },
    {
      "start": 115,
      "end": 118.009,
      "speaker": "小宇",
      "text": "林夏姐姐，表修好了，爷爷又可以给我讲以前的故事。",
      "kind": "dialogue"
    },
    {
      "start": 126,
      "end": 128.335,
      "speaker": "林夏",
      "text": "原来有些东西慢下来，也是在等一个故事。",
      "kind": "dialogue"
    },
    {
      "start": 158,
      "end": 160.47,
      "speaker": "小宇",
      "text": "姐姐，你的伞。下次下雨，再来坐一会儿吧。",
      "kind": "dialogue"
    },
    {
      "start": 178,
      "end": 180.476,
      "speaker": "林夏",
      "text": "谢谢你，小宇。看来今天，也没有白等。",
      "kind": "dialogue"
    },
    {
      "start": 195,
      "end": 196.181,
      "speaker": "陈伯",
      "text": "慢慢走。路还长着呢。",
      "kind": "dialogue"
    }
  ],
  "narration": {
    "normal-balanced": [
      {
        "start": 8,
        "end": 10.16,
        "text": "林夏收起黑伞，站在钟表铺门前。",
        "kind": "narration"
      },
      {
        "start": 34,
        "end": 36.903,
        "text": "店里透出暖光。灰发老人戴着眼镜，低头修表。",
        "kind": "narration"
      },
      {
        "start": 63,
        "end": 65.879,
        "text": "林夏站在工作台左侧，米色风衣的衣角还带着水。",
        "kind": "narration"
      },
      {
        "start": 81,
        "end": 83.74,
        "text": "藏蓝雨衣的男孩站在门边，肩上背着红色书包。",
        "kind": "narration"
      },
      {
        "start": 105,
        "end": 107.81,
        "text": "陈伯坐在桌前，手边是一只打开的金色怀表。",
        "kind": "narration"
      },
      {
        "start": 136,
        "end": 138.717,
        "text": "三个身影围着旧工作台，桌灯照亮细小的零件。",
        "kind": "narration"
      },
      {
        "start": 148,
        "end": 150.833,
        "text": "雨停了，夕阳落在老街上，水洼映出金色的光。",
        "kind": "narration"
      },
      {
        "start": 168,
        "end": 170.972,
        "text": "小宇把黑伞递给林夏，两人望着彼此，微微笑着。",
        "kind": "narration"
      },
      {
        "start": 186,
        "end": 188.694,
        "text": "陈伯站在店门口挥手，身后是一屋子安静的钟。",
        "kind": "narration"
      }
    ],
    "normal-concise": [
