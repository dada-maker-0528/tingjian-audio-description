# Server-side only. Judges fill in their own MiniMax, Volcengine, and Bailian keys.
# Copy this file to .env. The submitting team does not provide its production keys.
# Do not upload the completed .env to a public submission portal or Git repository.

# MiniMax: required for real uploaded-video understanding and text/audio analysis.
AIMEDIA_API_KEY=
AIMEDIA_PROVIDER=minimax
AIMEDIA_BASE_URL=https://api.minimaxi.com/v1
AIMEDIA_VISION_MODEL=MiniMax-M3
AIMEDIA_ASR_MODEL=asr-1.0

# Volcengine Doubao TTS: required for new voice synthesis and prompt audio.
VOLC_TTS_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
TINGJIAN_TTS_PROVIDER=doubao

# Alibaba Cloud Bailian: required for browser microphone realtime recognition.
# The base URL and key must belong to the same region and authorized workspace.
TINGJIAN_ASR_BASE_URL=
TINGJIAN_ASR_API_KEY=
TINGJIAN_ASR_MODEL=qwen3-asr-flash-realtime

# Local runtime. FFmpeg can be in PATH or set to its absolute executable path.
PORT=5294
AIMEDIA_DATA_DIR=./data
FFMPEG_PATH=ffmpeg

# Leave blank for localhost. Set only when deploying behind your own HTTPS domain.
TINGJIAN_PUBLIC_ORIGIN=
